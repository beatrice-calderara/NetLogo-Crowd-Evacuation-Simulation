<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[extensions [bitmap rnd]
breed [fire-turtles fire-turtle]
breed [people person]


; --- GLOBAL ATTRIBUTES ---
globals [
  alarm?                   ; true when evacuation alarm has been triggered
  people_left              ; number of people still alive in the simulation
  time_of_evacuation       ; tick counter that starts when alarm is triggered
  max_people_on_patch      ; maximum number of people allowed on a single walkable patch
  max_people_on_patch_exit ; maximum number of people allowed on a single exit patch
  injury_levels_histogram  ; list collecting injury levels of evacuated people, used for plotting

  
  ; --- EXIT GATE PATCH-SETS ---
  ; Each variable holds the set of patches belonging to that specific gate.
  ; Pre-built in draw_map_SC and never modified afterwards.
  S_gate   ; south gate
  SW_gate  ; south-west gate
  SE_gate  ; south-east gate
  N_gate   ; north gate (only active when real_exits is false)
  NW_gate  ; north-west gate
  NE_gate  ; north-east gate

  
  ; --- INJURY LEVEL COUNTERS ---
  ; Track how many evacuated people reached each injury level.
  ; Updated in update_injury_output when a person successfully exits.
  il0  ; healthy   (injury level 0)
  il1  ; minor     (injury level 1)
  il2  ; moderate  (injury level 2)
  il3  ; serious   (injury level 3)
  il4  ; severe    (injury level 4)
  il5  ; critical  (injury level 5)
  ; Note: fatal (level 6) people never evacuate, so no il6 counter is needed

  
  ; --- FIRE SYSTEM GLOBALS ---
  fire_active?     ; true once ignite_fire has been called; gates spread_fire every tick
  all_gates        ; union of all gate patch-sets, pre-computed once in setup to avoid repeated runtime scans of the full patch grid
  white_patches    ; all walkable (white) patches, pre-computed once in setup
  fire_candidates  ; subset of white_patches far from exits, pre-computed in setup so that ignite_fire requires zero runtime computation
  fire_patches     ; agentset of patches currently on fire, grows incrementally as fire spreads — never rebuilt from scratch
  fire_origin      ; the patch where the fire was first ignited, used to enforce the maximum spread radius (hardcoded to 50 units)

]



; --- PERSON ATTRIBUTES ---
people-own[
  speed            ; movement steps per tick, varies with injury level, age and gender
  destination      ; target exit patch the person is heading toward
  health_state     ; numeric health value in range [0, 100]; decreases due to crowding, fire exposure and smoke inhalation
  injury_level     ; discrete injury severity in range [0, 6] derived from health_state
                   ; 0=healthy 1=minor 2=moderate 3=serious 4=severe 5=critical 6=fatal
  evac_time        ; timer value recorded when the person successfully exits the arena
  direction_to_go  ; random walk direction during pre-alarm phase ("left" or "right")
  rational         ; T/F — if true the person makes goal-directed decisions; if false they follow the crowd (overridden by panic)
  panic            ; T/F — if true the person probabilistically loses rationality
  panic_percentage ; probability in range (0, 0.75] of irrational behavior when panicking
  aware            ; T/F — if true the person knows the arena layout and picks the nearest exit; also enables the deliberative BDI layer for fire avoidance
  evacuated        ; T/F — set to true when the person steps onto an exit patch
  escaping         ; T/F — set to true when the alarm triggers; gates movement toward exits
  dead             ; T/F — set to true when injury_level reaches 6 (fatal)
  age              ; demographic category: C = child / A = adult / E = elderly
                   ; affects speed penalty and injury weight multiplier
  gender            ; M = male / F = female — female agents have a speed penalty of 1
]


; --- PEATCHES ATTRIBUTES ---
; Each patch represents approximately one square meter of arena floor.
patches-own [
  num_people   ; number of alive people currently standing on this patch; used to enforce max_people_on_patch crowding threshold
  on_fire?     ; true if this patch is actively burning; set by ignite_fire and spread_fire, never reset during a run
  smoke_level  ; local smoke density, range [0, smoke_radius]; computed by diffusion in spread_fire every 3 ticks
  base_pcolor  ; snapshot of the original patch color taken at end of draw_map_SC;
               ; used by all movement logic so that smoke/fire visualization changes to pcolor never break collision and exit detection
]



; ---------------------------------------------------------------------------
; PROCEDURE: draw_map_SC
; Procedurally draws the arena map using patch coloring.
; Color convention:
;   WHITE  — walkable interior floor
;   BLACK  — walls and exterior (impassable)
;   RED    — exit gates (evacuation targets)
;   GRAY   — central statue obstacle
;
; The arena dimensions are scaled by the global slider "scale".
; Wall thickness is controlled by the global slider "wall-thickness".
; The north gate is only painted when real_exits is false (symmetric scenario).
;
; At the end, base_pcolor is snapshotted for every patch so that fire/smoke visualization can alter pcolor freely without breaking the movement logic that relies on original patch colors.
; ---------------------------------------------------------------------------
to draw_map_SC

  set N_gate no-patches
  set S_gate no-patches
  set SE_gate no-patches
  set SW_gate no-patches
  set NE_gate no-patches
  set NW_gate no-patches

  let halfW ((38 + wall-thickness) * scale)
  let halfH ((84 + wall-thickness) * scale)
  let margin (1 * scale)

  resize-world (- halfW - margin) (halfW + margin) (- halfH - margin) (halfH + margin)
  set-patch-size 1

  ask patches [
    ; default: everything is outside / wall
    set pcolor black

    ; internal walkable area
    if (abs pxcor / scale < 38) and (abs pycor / scale < 84) [
      set pcolor white
    ]

    ; S EXIT
    if ((pycor / scale <= -84) and (pycor / scale >= -84 - wall-thickness) and
        (pxcor / scale <= 5.4) and (pxcor / scale >= -5.4)) [
      set pcolor red
      set S_gate (patch-set S_gate self)
    ]

    ; N EXIT
    if ((pycor / scale >= 84) and (pycor / scale <= 84 + wall-thickness) and
        (pxcor / scale <= 6.1) and (pxcor / scale >= -6.1) and
        (not real_exits)) [
      set pcolor red
      set N_gate (patch-set N_gate self)
    ]

    ; SE EXIT
    if ((pxcor / scale >= 38) and (pxcor / scale <= 38 + wall-thickness) and
        (pycor / scale > -84) and (pycor / scale <= -73)) [
      set pcolor red
      set SE_gate (patch-set SE_gate self)
    ]

    ; SW EXIT
    if ((pxcor / scale <= -38) and (pxcor / scale >= -38 - wall-thickness) and
        (pycor / scale > -84) and (pycor / scale <= -73)) [
      set pcolor red
      set SW_gate (patch-set SW_gate self)
    ]

    ; NE EXIT
    if ((pxcor / scale >= 38) and (pxcor / scale <= 38 + wall-thickness) and
        (pycor / scale >= 73) and (pycor / scale < 84)) [
      set pcolor red
      set NE_gate (patch-set NE_gate self)
    ]

    ; NW EXIT
    if ((pxcor / scale <= -38) and (pxcor / scale >= -38 - wall-thickness) and
        (pycor / scale >= 73) and (pycor / scale < 84)) [
      set pcolor red
      set NW_gate (patch-set NW_gate self)
    ]

    ; statue
    if (abs pycor / scale <= 6.25) and (abs pxcor / scale <= 5) [
      set pcolor gray
    ]
  ]

  ask patches [ set base_pcolor pcolor ]
end


; ---------------------------------------------------------------------------
; PROCEDURE: setup
; Initializes the entire simulation from scratch.
; Draws the arena map, pre-computes static agentsets for performance, spawns the population with demographic attributes, and resets all counters and fire system variables.
; Must be called before start_simulation or start_evacuation.
; ---------------------------------------------------------------------------
to setup
  clear-all
  reset-ticks
  random-seed 42
  
  ; Draw the arena: walls, exits, obstacle and exterior
  draw_map_SC 

  
  ; Pre compute static agent sets. 
  ; The map geometry never changes during a run, so these are built once here and reused everywhere to avoid expensive runtime patch scans.
  set all_gates     (patch-set S_gate SW_gate SE_gate N_gate NW_gate NE_gate)
  set white_patches patches with [pcolor = white]
  
  
  ; Fire candidates: white patches used by ignite_fire to place the fire origin away from evacuation routes
  set fire_candidates white_patches with [
    (min [distance myself] of all_gates) > 20
  ]
  if not any? fire_candidates [
    set fire_candidates white_patches
  ]
  
  
  ; All people start as healthy adult males facing a random direction.
  ; Demographic attributes (gender, age, panic, awareness) are assigned afterwards as random subsets of the population.
  create-people population [
    set color rgb 0 255 0
    set shape "person"
    set size people_dim
    set speed 1
    set rational true
    set panic false
    set panic_percentage 0
    set aware false
    set escaping false
    set evacuated false
    set dead false
    set health_state 100
    set gender "M"
    set age "A"
    move-to one-of white_patches 
  ]

  
  ; Counters and flags 
  set il0 0
  set il1 0
  set il2 0
  set il3 0
  set il4 0
  set il5 0
  set injury_levels_histogram []
  set alarm? false
  set max_people_on_patch 10
  ifelse real_exits [set max_people_on_patch_exit max_people_on_patch] [set max_people_on_patch_exit 2]
  set time_of_evacuation 0
  
  ; Demographic assignemnt. 
  ; Subsets of the population are flagged according to interface slider fractions. 
  ask n-of (round aware_fraction / 100 * population) people [set aware true]
  ask n-of (round panic_fraction / 100 * population) people [set panic true]
  ask n-of (round female_fraction / 100 * population) people [set gender "F"]
  ask n-of (round children_fraction / 100 * population) people [set age "C"]
  ask n-of (round elderly_fraction / 100 * population) people [set age "E"]
  ask people with [panic = true] [set panic_percentage random-float 0.75]

  
  ; Fire system initialization
  set fire_active? false
  ask patches [
    set on_fire?    false
    set smoke_level 0
  ]
  
  set fire_patches no-patches
end



; ---------------------------------------------------------------------------
; PROCEDURE: start_simulation
; Main simulation loop — called every tick by the "Start Simulation" button.
; Handles three distinct phases in order:
;   1. Pre-alarm: people wander randomly until the alarm is triggered
;   2. Evacuation: people move toward exits, with panic and rational variants
;   3. Fire: fire is ignited after fire_delay ticks and spreads each tick
; ---------------------------------------------------------------------------
to start_simulation
  
  ; --- PHASE 1: PRE-ALARM RANDOM MOVEMENT ---
  ; Before the alarm, people perform a weighted random walk (left or right).
  ; They only step forward if the next patch is a walkable floor patch.
  if (alarm? = false) [
    ask people [
      let items ["left" "right"]
      let probabilities [0.5 0.5]
      let pairs (map list items probabilities)
      set direction_to_go first rnd:weighted-one-of-list pairs last
      ifelse (direction_to_go = "right")
        [right random 45]
        [left random 45]
      if [base_pcolor] of patch-ahead 1 = white [forward 1] ; MODIFIED: base_pcolor
    ]
  ]

  
  ; --- TERMINATION CHECK ---
  ; Stop the simulation when every person still alive has died.
  if ((count people) = (count people with [dead]) and alarm? = true) [set alarm? false stop]

  
  ; --- PHASE 2: EVACUATION MOVEMENT ---
  ; Rational (non-panicking) people call move_forward, which applies both the deliberative BDI layer (fire rerouting) and the reactive layer (step avoidance).
  ask people with [escaping = true and health_state > 0 and panic = false] [
    update_people_status
    if not dead [ move_forward ]
  ]
  
  ; Panicking people probabilistically switch between rational and irrational behavior.
  ; Rational ticks: move normally and reset panic.
  ; Irrational ticks: follow the crowd (follow_crowd procedure).
  ask people with [escaping = true and health_state > 0 and panic = true] [
    update_people_status
    if not dead [
      let items [false true]
      let p panic_percentage
      let probabilities list (p) (1 - p)
      let pairs (map list items probabilities)
      set rational first rnd:weighted-one-of-list pairs last
      ifelse (rational = true)
        [move_forward
         set panic false]
        [follow_crowd]
    ]
  ]

  
  ; --- PHASE 3: FIRE SYSTEM ---
  ; Ignition: triggered once when all four conditions are met simultaneously.
  if (fire_hazard_enabled) and (alarm?) and (not fire_active?) and
     (time_of_evacuation >= fire_delay) [
    ignite_fire
  ]
  
  if fire_active? [ spread_fire ]   ; Propagate fire if already active

  
  if alarm? [ set time_of_evacuation time_of_evacuation + 1 ]
  ask patches [set num_people count people-here with [not dead]]
  set people_left count people
  tick
end

to start_evacuation
  set alarm? true
  reset-timer
  ask people [
    set escaping true
    ifelse (aware = true)
      [set destination one-of get_patch_set min-one-of all_gates [distance myself]] 
      [set destination one-of all_gates]                                             
    face destination
  ]
end



; ---------------------------------------------------------------------------
; REPORTER: get_patch_set [p]
; Given a single patch p, returns the full gate agentset that p belongs to.
; Used in start_evacuation so that aware people are assigned a destination drawn from the entire gate group, not just a single patch.
; ---------------------------------------------------------------------------
to-report get_patch_set [p]
  (
    ifelse member? p NE_gate [report NE_gate]
           member? p NW_gate [report NW_gate]
           member? p SW_gate [report SW_gate]
           member? p SE_gate [report SE_gate]
           member? p S_gate  [report S_gate]
           member? p N_gate  [report N_gate]
  )
end



; ---------------------------------------------------------------------------
; PROCEDURE: move_person
; Moves the calling person agent one step toward their destination exit.
; Handles all terrain cases: free floor, crowded floor, free exit, crowded exit, wall and obstacle.
;
; IMPORTANT: do not call this procedure directly.
;            Always call move_forward, which applies speed, slip and the deliberative BDI layer before entering the movement loop.
;
; Movement priority (evaluated top to bottom):
;   0. If already evacuated → record injury and remove from simulation
;   1. REACTIVE LAYER: if next patch is on fire → detour to safe neighbor
;   2. Next patch is free floor → step forward
;   3. Next patch is crowded floor → detour to least-congested neighbor
;   4. Next patch is free exit → step through, mark as evacuated
;   5. Next patch is crowded exit → reroute to a less congested exit
;   6. Next patch is a wall → try nearby exit or free neighbor, else reroute
;   7. Next patch is the statue obstacle → pick a new exit and try to move
; ---------------------------------------------------------------------------
to move_person
  
  ; Case 0: person has already crossed an exit patch in a previous step
  ; Record their final injury level and remove them from the simulation.
  if evacuated [update_injury_output die]
  if evacuated [update_injury_output die]

  ; ---------------------------------------------------------------
  ; REACTIVE LAYER (all agents, regardless of awareness or panic)
  ; Pure stimulus-response: if the very next patch is burning, do not enter it. Find the safest accessible neighbor instead.
  ; This layer has priority over all destination-directed movement below.
  ; ---------------------------------------------------------------
  if fire_active? and [on_fire?] of patch-ahead 1 [
    let safe-neighbors neighbors with [
      base_pcolor = white and
      not on_fire? and
      num_people < max_people_on_patch
    ]
    ifelse any? safe-neighbors [
      ; Step toward the safe neighbor that keeps the person closest to their destination
      face min-one-of safe-neighbors [distance [destination] of myself]
      forward 1
      face destination
    ][
      ; No safe neighbors available: stay in place and reface destination
      face destination
    ]
    stop  ; skip the rest of move_person this tick
  ]
  
  (ifelse
    ; Case 2: next patch is free walkable floor — simply advance
    [base_pcolor = white and num_people < max_people_on_patch] of patch-ahead 1
      [forward 1]

    ; Case 3: next patch is walkable but overcrowded — detour via least-congested neighbor
    [base_pcolor = white and num_people >= max_people_on_patch] of patch-ahead 1
      [
        face min-one-of neighbors with [(base_pcolor = white)] [distance [destination] of myself]
        forward 1
        face destination
      ]

    ; Case 4: next patch is an exit and not overcrowded — cross and mark as evacuated
    [base_pcolor = red and num_people < max_people_on_patch_exit] of patch-ahead 1
      [
        forward 1
        set evacuated true
        set evac_time timer
      ]

    ; Case 5: next patch is an exit but overcrowded — reroute to a less congested gate
    [base_pcolor = red and num_people >= max_people_on_patch_exit] of patch-ahead 1
      [
        set destination min-one-of all_gates with [num_people < max_people_on_patch_exit] [distance myself]
        if any? neighbors with [(base_pcolor = white) and num_people < max_people_on_patch] [
          face min-one-of neighbors with [(base_pcolor = white) and num_people < max_people_on_patch] [distance [destination] of myself]
          forward 1
          face destination
        ]
      ]

    ; Case 6: next patch is a wall
    [base_pcolor] of patch-ahead 1 = black
      [
        (ifelse any? neighbors with [(base_pcolor = red) and num_people < max_people_on_patch_exit] ; 6a: an uncrowded exit is adjacent — go through it immediately
          [
            face min-one-of neighbors with [base_pcolor = red] [distance [destination] of myself]
            forward 1
            set evacuated true
            set evac_time timer
          ]
          any? neighbors with [(base_pcolor = white) and num_people < max_people_on_patch]          ; 6b: a free floor patch is adjacent — step sideways along the wall
          [
            face min-one-of neighbors with [base_pcolor = white] [distance [destination] of myself]
            forward 1
            face destination
          ]
          ; 6c: completely blocked — reassign destination to the nearest uncrowded exit
          [
            set destination min-one-of all_gates with [num_people < max_people_on_patch_exit] [distance [destination] of myself]
          ]
        )
      ]
    
     ; Case 7: next patch is the central statue obstacle — pick a new exit and try to advance
    [base_pcolor = gray] of patch-ahead 1
      [
        set destination one-of all_gates ; MODIFIED: all_gates
        face destination
        if [(base_pcolor = white) and num_people < max_people_on_patch] of patch-ahead 1 [forward 1]
      ]
  )
end



; ---------------------------------------------------------------------------
; PROCEDURE: update_people_status
; Called every tick for each active person during evacuation.
; Updates health, injury level, visual color and movement speed in sequence.
; The order matters: health must be updated before injury level, and injury level must be updated before speed.
; ---------------------------------------------------------------------------
to update_people_status
  let n count (people-on patch-here) with [not dead]
  set health_state update_hs n
  if health_state < 0 [set health_state 0]
  update_injury_level
  (
    ifelse injury_level = 6 [set dead true set color rgb 255 0 0          ; fatal   — red         
                             set injury_levels_histogram fput injury_level injury_levels_histogram]
           injury_level = 5 [set color rgb 255 102 0]                     ; critical — dark orange
           injury_level = 4 [set color rgb 255 204 0]                     ; severe   — yellow
           injury_level = 3 [set color rgb 0 153 255]                     ; serious  — blue
           injury_level = 2 [set color rgb 0 255 255]                     ; moderate — cyan
           injury_level = 1 [set color rgb 153 255 102]                   ; minor    — light green
           injury_level = 0 [set color rgb 0 255 0]                       ; healthy  — green
  )
  update_speed
end



; ---------------------------------------------------------------------------
; PROCEDURE: update_injury_level
; Derives the discrete AIS injury level (0–6) from the current health_state.
; The mapping is linear: each 15-point drop in health advances one level.
;   health 100–85 → level 0 (healthy)
;   health  84–70 → level 1 (minor)
;   health  69–55 → level 2 (moderate)
;   health  54–40 → level 3 (serious)
;   health  39–25 → level 4 (severe)
;   health  24–10 → level 5 (critical)
;   health   9–0  → level 6 (fatal)
;
; Fatal is irreversible: once injury_level reaches 6 it stays at 6 forever, regardless of any subsequent health fluctuations.
; ---------------------------------------------------------------------------
to update_injury_level
  if injury_level = 6 [ stop ]
  set injury_level max list (6 - (floor (health_state / 15))) 0
  
end


; ---------------------------------------------------------------------------
; REPORTER: update_hs [n]
; Returns the new health_state after applying crowding damage for this tick.
; Damage per tick = (n - 1) × injury_weight, where n is the number of alive people on the same patch (the person itself does not count).
; Age multipliers reflect higher physiological vulnerability:
;   Adult   → base damage × 1
;   Elderly → base damage × 2
;   Child   → base damage × 3
; ---------------------------------------------------------------------------
to-report update_hs [n]
  (
    ifelse age = "A" [report health_state - ((n - 1) * injury_weight)]
           age = "E" [report health_state - ((n - 1) * injury_weight * 2)]
           age = "C" [report health_state - ((n - 1) * injury_weight * 3)]
  )
end


; ---------------------------------------------------------------------------
; PROCEDURE: update_speed
; Sets the person's movement speed (steps per tick) based on injury level.
; Base speeds decrease with injury severity, then penalties are applied for age (elderly −3, child −2) and gender (female −1).
; A minimum speed of 1 is enforced for non-fatal injuries to prevent complete immobility before death.
; ---------------------------------------------------------------------------
to update_speed
  (
    ifelse injury_level = 6 [set speed 0]   ; fatal    — immobile
           injury_level = 5 [set speed 1]   ; critical
           injury_level = 4 [set speed 2]   ; severe
           injury_level = 3 [set speed 3]   ; serious
           injury_level = 2 [set speed 4]   ; moderate
           injury_level = 1 [set speed 5]   ; minor
           injury_level = 0 [set speed 5]   ; healthy
  )
  
  ; Age penalty — elderly and children are slower
  (
    ifelse age = "E" [set speed speed - 3]
           age = "C" [set speed speed - 2]
  )
  
  ; Gender penalty — female agents move slightly slower
  if gender = "F" [set speed speed - 1]
  
  ; Enforce minimum speed: injured but alive people can always take at least 1 step
  if (speed <= 0) and (injury_level < 6) [set speed 1]
  ; Fatal agents are fully immobile
  if (speed < 0)  and (injury_level = 6) [set speed 0]
end



; ---------------------------------------------------------------------------
; PROCEDURE: deliberative_reroute
; Implements the deliberative layer of the BDI architecture for aware agents.
; Re-evaluates the current destination every 5 ticks using a cost function that balances evacuation efficiency against fire safety.
;
; Only aware agents have an active deliberative layer — unaware and panicking agents rely exclusively on the reactive layer in move_person.
;
; Cost function (minimized over all exits):
;   cost(gate) = dist(agent → gate) − safety_weight × min_dist(gate → fire)
; A higher safety_weight makes the agent prefer exits farther from fire, even at the cost of a longer path.
;
; The agent only perceives fire within perception_radius patches, modeling bounded rationality: no agent has global map knowledge.
; ---------------------------------------------------------------------------
to deliberative_reroute
  if not aware [ stop ]                  ; only aware agents have a deliberative layer
  if not fire_active? [ stop ]           ; no fire present — no replanning needed
  if (ticks mod 5 != 0) [ stop ]

  ; Belief state: fire patches visible within the agent's perception radius
  let perceived-fire patches in-radius perception_radius with [on_fire?]
  if not any? perceived-fire [ stop ]     ; fire exists but is outside perception — no action

  ; Evaluate all exits and pick the one with the lowest cost.
  let best-exit min-one-of all_gates [
    (distance myself) - (safety_weight * (min [distance myself] of perceived-fire))
  ]

  ; Update destination only if the best exit has changed
  if best-exit != nobody and best-exit != destination [
    set destination best-exit
    face destination
  ]
end



; ---------------------------------------------------------------------------
; PROCEDURE: move_forward
; Entry point for all person movement during evacuation.
; Applies speed, slip check, health update and deliberative rerouting before entering the step-by-step movement loop.
;
; The person moves up to speed steps per tick, stopping early if they slip, die or complete evacuation mid-loop.
; ---------------------------------------------------------------------------
to move_forward
  ; If speed_enabled is off, all people move at exactly 1 step per tick
  if not speed_enabled [set speed 1]   
  
  ; Slip check: glass bottles on the ground may cause a fall
  let slip false
  if glass_bottles [set slip get_slip]
  if slip [set health_state health_state - (health_state / 20)]     ; A slip reduces health by 5% of current value
  let i 1
  update_people_status
  
  
  ; Deliberative layer: re-evaluate destination once before the movement loop.
  ; Placed here so replanning happens once per move cycle, not once per step.
  deliberative_reroute

  while [(i <= speed) and (not slip) and (not dead)] [
    move_person
    set i i + 1
  ]
end


; ---------------------------------------------------------------------------
; PROCEDURE: update_injury_output
; Called when a person successfully evacuates (just before die).
; Increments the global counter for their final injury level and appends the level to injury_levels_histogram for post-run plotting.
; Fatal agents (level 6) never evacuate, so il6 is not tracked here.
; ---------------------------------------------------------------------------
to update_injury_output
  (
    ifelse injury_level = 5 [set il5 il5 + 1]
           injury_level = 4 [set il4 il4 + 1]
           injury_level = 3 [set il3 il3 + 1]
           injury_level = 2 [set il2 il2 + 1]
           injury_level = 1 [set il1 il1 + 1]
           injury_level = 0 [set il0 il0 + 1]
  )
  set injury_levels_histogram fput injury_level injury_levels_histogram
end


; ---------------------------------------------------------------------------
; PROCEDURE: follow_crowd
; Movement behavior for panicking agents during irrational ticks.
; Instead of heading toward an exit, the person follows the densest neighboring patch — mimicking herding behavior under panic.
;
; Rationality partially overrides panic when an exit is immediately adjacent:
; if a gate patch is visible in the Moore neighborhood, the agent uses it regardless of panic state (proximity triggers a rational response).
; ---------------------------------------------------------------------------
to follow_crowd
  update_people_status
  if evacuated [update_injury_output die]
  
  ifelse any? neighbors with [(base_pcolor = red)]
  [
    ; Exit is adjacent — rationality overrides panic at close range
    (ifelse any? neighbors with [(base_pcolor = red) and num_people < max_people_on_patch_exit]
       [
        ; Uncrowded exit nearby — move through it
        face min-one-of neighbors with [(base_pcolor = red) and num_people < max_people_on_patch_exit] [distance myself]
        forward 1
        set evacuated true
       ]
       [
        ; All adjacent exits are overcrowded — reroute to nearest uncrowded gate
        set destination min-one-of all_gates with [num_people < max_people_on_patch_exit] [distance myself]
        face destination
       ]
    )
  ]
  [
    ; No exit adjacent — follow the crowd: move toward the most populated neighbor
    face max-one-of neighbors with [base_pcolor = white] [num_people]
    forward 1
  ]
end


; ---------------------------------------------------------------------------
; REPORTER: get_slip
; Returns true with probability slipping_chance / 100, false otherwise.
; Called in move_forward when the glass_bottles switch is enabled.
; ---------------------------------------------------------------------------
to-report get_slip
  let p random 100
  ifelse p <= slipping_chance
    [report true]
    [report false]
end



; ---------------------------------------------------------------------------
; PROCEDURE: ignite_fire
; Triggers the fire hazard at a single random patch chosen from fire_candidates.
; fire_candidates is pre-computed in setup as the set of central white patches far from all exits, ensuring the fire origin maximizes disruption without immediately blocking evacuation routes.
;
; Sets fire_active? to true, which gates spread_fire every subsequent tick.
; Records the ignition patch in fire_origin so spread_fire can enforce the maximum spread radius (hardcoded to 50 units).
; ---------------------------------------------------------------------------
to ignite_fire
  set fire_active? true
  ask one-of fire_candidates [
    set on_fire? true
    set fire_origin self          ; NEW: memorize ignition point
    set fire_patches (patch-set fire_patches self)
    sprout-fire-turtles 1 [
      set shape "square"
      set color orange
      set size 1.5
    ]
  ]
end



; ---------------------------------------------------------------------------
; PROCEDURE: spread_fire
; Called every tick once fire_active? is true. Handles four responsibilities:
;   1. PROPAGATION    — fire expands to adjacent white patches stochastically
;   2. ANIMATION      — fire-turtle colors oscillate to simulate flickering flames
;   3. SMOKE          — smoke diffuses outward from fire, decays over time, and is visualized as a gray tint on white patches
;   4. PEOPLE EFFECTS — fire and smoke damage health; dense smoke disorients agents
; ---------------------------------------------------------------------------
to spread_fire
  ; --- PROPAGATION ---
  ; Each burning patch attempts to ignite its four orthogonal white neighbors.
  ; Two conditions must both be satisfied:
  ;   (a) the candidate patch is within 50 units of fire_origin (radius cap)
  ;   (b) a random draw falls below fire_spread_rate (stochastic spread)
  ; This models a Probabilistic Cellular Automaton (PCA) with bounded growth.
  ask fire_patches [
    ask neighbors4 with [base_pcolor = white and not on_fire?] [
      if (distance fire_origin <= 50) and
         (random-float 1.0 < fire_spread_rate) [
        set on_fire? true
        set fire_patches (patch-set fire_patches self)
        sprout-fire-turtles 1 [
          set shape "square"
          set color orange
          set size 1.5
        ]
      ]
    ]
  ]

  ; --- VISUAL ANIMATION ---
  ; Randomly shift each fire-turtle's color among orange, red and yellow variants every tick to simulate flickering flames.
  ask fire-turtles [
    set color one-of (list orange red (orange + 2) (red - 2) (yellow - 2))
  ]

  ; --- SMOKE DIFFUSION AND VISUALIZATION (every 3 ticks) ---
  ; Smoke is modeled as a scalar field that diffuses by neighbor contagion rather than by in-radius scanning, giving O(white patches) cost per update.
  if (ticks mod 3 = 0) [

    ; Step 1 — emission: each burning patch sets its smoke level to the maximum
    ask fire_patches [
      set smoke_level smoke_radius
    ]

    ; Step 2 — diffusion: smoke spreads to neighboring white non-burning patches with a 40% decay per step (each neighbor receives 60% of the sender's level).
    ; A neighbor only updates if the diffused value exceeds its current level, preventing smoke from flowing back toward the source.
    ask patches with [base_pcolor = white and not on_fire? and smoke_level > 0] [
      ask neighbors4 with [base_pcolor = white and not on_fire?] [
        let diffused [smoke_level] of myself * 0.6
        if diffused > smoke_level [
          set smoke_level diffused
        ]
      ]
    ]

    ; Step 3 — dissipation: smoke naturally decays by 15% each update cycle.
    ; Levels below 0.05 are zeroed out to avoid accumulating near-zero values.
    ask patches with [base_pcolor = white and not on_fire? and smoke_level > 0] [
      set smoke_level smoke_level * 0.85
      if smoke_level < 0.05 [ set smoke_level 0 ]
    ]

    ; Step 4 — visualization: tint smoky patches with a gray shade proportional to smoke density. 
    ; Only patches that currently have smoke or that previously had smoke are updated, skipping the rest.
    ask patches with [base_pcolor = white and (smoke_level > 0 or pcolor != base_pcolor)] [
      ifelse smoke_level > 0 and not on_fire? [
        let intensity clamp (smoke_level / smoke_radius) 0 0.75
        set pcolor rgb (round (255 - (intensity * 180)))
                       (round (255 - (intensity * 180)))
                       (round (255 - (intensity * 160)))
      ][
        if not on_fire? [ set pcolor base_pcolor ]
      ]
    ]
  ]

  ; --- EFFECTS ON PEOPLE ---
  ; Applied every tick to all alive agents, regardless of escaping status, since pre-alarm wanderers can also be caught by a delayed fire.
  ask people with [not dead] [
    let here_burning?    [on_fire?]    of patch-here
    let here_smoke_level [smoke_level] of patch-here

    ; Direct fire damage: standing on a burning patch causes full fire_damage_rate health loss per tick — the most severe exposure level.
    if here_burning? [
      set health_state health_state - fire_damage_rate
    ]

    ; Smoke inhalation damage: reduced to 30% of fire_damage_rate, scaled by local smoke density relative to the maximum (smoke_radius).
    ; Only applied on non-burning patches to avoid double-counting.
    if (here_smoke_level > 0) and (not here_burning?) [
      set health_state health_state - (fire_damage_rate * 0.3 * here_smoke_level / smoke_radius)
    ]

    ; Visibility impairment: dense smoke above smoke_visibility_threshold causes probabilistic disorientation (40% chance per tick). 
    ; The agent loses their current exit heading and is redirected to a random gate.
    ; The effect is per-tick and non-permanent: agents who leave the smoke zone will have their destination corrected by deliberative_reroute.
    if (here_smoke_level >= smoke_visibility_threshold) and (escaping) [
      if random-float 1.0 < 0.4 [
        set destination one-of all_gates
        face destination
      ]
    ]

    if health_state < 0 [ set health_state 0 ]
  ]
end


; ---------------------------------------------------------------------------
; REPORTER: clamp [x lo hi]
; Returns x constrained to the closed interval [lo, hi].
; Used by spread_fire to keep smoke visualization intensity in [0, 0.75].
; ---------------------------------------------------------------------------
to-report clamp [x lo hi]
  report max (list lo (min list hi x))
end]]></code>
